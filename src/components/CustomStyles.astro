---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(13 148 136);
    --aw-color-secondary: rgb(15 118 110);
    --aw-color-accent: rgb(20 184 166);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(9 11 12);

    ::selection {
      background-color: rgb(20 184 166 / 30%);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(20 184 166);
    --aw-color-secondary: rgb(13 148 136);
    --aw-color-accent: rgb(45 212 191);

    --aw-color-text-heading: rgb(247 248 248);
    --aw-color-text-default: rgb(226 232 234);
    --aw-color-text-muted: rgb(226 232 234 / 66%);
    --aw-color-bg-page: rgb(9 11 12);

    ::selection {
      background-color: rgb(20 184 166 / 35%);
      color: snow;
    }
  }
</style>
