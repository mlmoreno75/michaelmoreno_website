---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';
import type { CallToAction, Widget } from '~/types';

export interface ContactPath {
  label: string;
  text: string;
  action: CallToAction;
  /** Optional plain text link rendered under the button. */
  secondaryLink?: { text: string; href: string; target?: string };
}

interface Props extends Widget {
  title?: string;
  subtitle?: string;
  paths: ContactPath[];
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  paths = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const TEAL_OUTLINE =
  'border-primary text-primary hover:bg-primary hover:border-primary hover:text-white dark:border-primary dark:text-primary dark:hover:bg-primary dark:hover:text-white';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline
    title={title}
    subtitle={subtitle}
    classes={{
      container: 'text-center mb-10 md:mb-12',
      title: 'text-4xl md:text-5xl font-bold tracking-tighter font-heading',
      subtitle: 'text-xl text-muted dark:text-slate-400',
    }}
  />

  <div class="grid gap-6 md:grid-cols-2">
    {
      paths.map(({ label, text, action, secondaryLink }) => (
        <div class="flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-8 shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <p class="text-sm font-semibold uppercase tracking-wide text-primary">{label}</p>
          <p class="mt-3 flex-1 text-lg leading-relaxed text-muted dark:text-slate-300">{text}</p>
          <div class="mt-8 flex flex-col items-start gap-3">
            <Button
              {...action}
              class:list={['w-full sm:w-auto whitespace-nowrap', action.variant === 'secondary' && TEAL_OUTLINE]}
            />
            {secondaryLink && (
              <a
                href={secondaryLink.href}
                target={secondaryLink.target}
                rel={secondaryLink.target === '_blank' ? 'noopener noreferrer' : undefined}
                class="text-sm font-medium text-muted underline-offset-4 hover:text-primary hover:underline dark:text-slate-400 dark:hover:text-primary"
              >
                {secondaryLink.text}
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</WidgetWrapper>
