---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import Projects from '~/components/widgets/Projects.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Contact from '~/components/widgets/Contact.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Michael Moreno',
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`), so
// it is correct for any site made with the template. Blog posts add
// BlogPosting on their own.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'About', href: '#about' },
        { text: 'Expertise', href: '#expertise' },
        { text: 'Experience', href: '#experience' },
        { text: 'Accomplishments', href: '#accomplishments' },
        { text: 'Blog', href: '#blog' },
      ]}
      actions={[{ text: 'Message Me', href: '#contact' }]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    title="Michael Moreno"
    actions={[
      { variant: 'primary', text: 'Download Résumé', href: '/resume.pdf', icon: 'tabler:download' },
      { variant: 'secondary', text: 'Message Me', href: '#contact' },
    ]}
  >
    <Fragment slot="subtitle">
      <span class="block text-xl sm:text-2xl font-semibold text-heading">[Headline: one line about what you do]</span>
      <span class="block mt-2">[Subhead: one line about who you help and how]</span>
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    id="stats"
    stats={[
      { amount: '[00]+', title: '[Label one]' },
      { amount: '[00]', title: '[Label two]' },
      { amount: '[$0M]', title: '[Label three]' },
      { amount: '[00%]', title: '[Label four]' },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-linkedin',
        callToAction: {
          target: '_blank',
          text: 'LinkedIn',
          href: '#',
        },
      },
      {
        icon: 'tabler:brand-github',
        callToAction: {
          target: '_blank',
          text: 'GitHub',
          href: '#',
        },
      },
      {
        icon: 'tabler:brand-x',
        callToAction: {
          target: '_blank',
          text: 'X',
          href: '#',
        },
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1491349174775-aaafddd81942?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Portrait placeholder',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About me</h2>
      <p>[Paragraph one: your background, what you do today, and the kind of problems you like to solve.]</p>
      <br />
      <p>[Paragraph two: how you work, what you value, and what people can expect when they work with you.]</p>
      <br />
      <p>[Closing line: where to find you online.]</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Features3 Widget ************** -->

  <Features3
    id="expertise"
    title="Expertise"
    subtitle="[One line introducing the three areas you are known for.]"
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: '[Expertise area one]',
        description: '[Two lines describing what you do in this area and the results it produces.]',
        icon: 'tabler:target',
      },
      {
        title: '[Expertise area two]',
        description: '[Two lines describing what you do in this area and the results it produces.]',
        icon: 'tabler:chart-arrows',
      },
      {
        title: '[Expertise area three]',
        description: '[Two lines describing what you do in this area and the results it produces.]',
        icon: 'tabler:users-group',
      },
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    id="experience"
    title="Experience"
    items={[
      {
        title:
          '[Role title] <br /> <span class="font-normal">[Company], [City, ST]</span> <br /> <span class="text-sm font-normal">[Year] - Present</span>',
        description: `[Responsibility or outcome one.] <br /> [Responsibility or outcome two.] <br /> [Responsibility or outcome three.]`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          '[Previous role title] <br /> <span class="font-normal">[Company], [City, ST]</span> <br /> <span class="text-sm font-normal">[Year] - [Year]</span>',
        description: `[Responsibility or outcome one.] <br /> [Responsibility or outcome two.] <br /> [Responsibility or outcome three.]`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          '[Earlier role title] <br /> <span class="font-normal">[Company], [City, ST]</span> <br /> <span class="text-sm font-normal">[Year] - [Year]</span>',
        description: `[Responsibility or outcome one.] <br /> [Responsibility or outcome two.]`,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Projects Widget *************** -->

  <Projects
    id="accomplishments"
    title="Key accomplishments"
    subtitle="[One line framing the work you are proudest of and why it mattered.]"
    items={[
      {
        title: '[Accomplishment one]',
        description: '[Two or three sentences on the challenge, what you did, and who it was for.]',
        image: {
          src: 'https://images.unsplash.com/photo-1658248165252-71e116af1b34?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=928&q=80',
          alt: 'Accomplishment one placeholder image',
        },
        tags: ['[Tag]', '[Tag]', '[Tag]'],
        result: '[Outcome: the measurable result, e.g. +00% revenue]',
      },
      {
        title: '[Accomplishment two]',
        description: '[Two or three sentences on the challenge, what you did, and who it was for.]',
        image: {
          src: 'https://images.unsplash.com/photo-1619983081563-430f63602796?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Accomplishment two placeholder image',
        },
        tags: ['[Tag]', '[Tag]'],
        result: '[Outcome: the measurable result, e.g. $0M saved]',
      },
      {
        title: '[Accomplishment three]',
        description: '[Two or three sentences on the challenge, what you did, and who it was for.]',
        image: {
          src: 'https://images.unsplash.com/photo-1664455340023-214c33a9d0bd?ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
          alt: 'Accomplishment three placeholder image',
        },
        tags: ['[Tag]', '[Tag]', '[Tag]'],
        result: '[Outcome: the measurable result, e.g. 00 teams onboarded]',
      },
    ]}
  />

  <!-- Testimonials Widget *********** -->

  <Testimonials
    id="testimonials"
    title="Testimonials"
    subtitle="[One line introducing what colleagues and clients say about working with you.]"
    testimonials={[
      {
        testimonial: `[Testimonial one: two or three sentences in the speaker's own words.]`,
        name: '[Name]',
        job: '[Title, Company]',
        image: {
          src: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Placeholder portrait',
        },
      },
      {
        testimonial: `[Testimonial two: two or three sentences in the speaker's own words.]`,
        name: '[Name]',
        job: '[Title, Company]',
        image: {
          src: 'https://images.unsplash.com/photo-1554151228-14d9def656e4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=772&q=80',
          alt: 'Placeholder portrait',
        },
      },
      {
        testimonial: `[Testimonial three: two or three sentences in the speaker's own words.]`,
        name: '[Name]',
        job: '[Title, Company]',
        image: {
          src: 'https://images.unsplash.com/photo-1599566150163-29194dcaad36?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Placeholder portrait',
        },
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information={`[One or two lines about what you write about and who it is for.]`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>

  <!-- Contact Widget **************** -->

  <Contact
    id="contact"
    title="Get in touch"
    subtitle="[One line inviting people to reach out and what to expect.]"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    disclaimer={{
      label: '[Disclaimer: how you handle the information submitted through this form.]',
    }}
    description="[Response time, e.g. I typically reply within two business days.]"
    button="Send message"
  />
</Layout>
