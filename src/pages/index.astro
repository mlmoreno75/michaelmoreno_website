---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import Projects from '~/components/widgets/Projects.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';

const LINKEDIN_URL = 'https://www.linkedin.com/in/michael-moreno';

// Original template blue for the two primary CTAs. `btn-primary` sets `dark:bg-primary`,
// so the dark variants are required for the override to win in dark mode.
const BLUE_BUTTON = [
  'bg-[rgb(1_97_239)] border-[rgb(1_97_239)] text-white',
  'hover:bg-[rgb(1_84_207)] hover:border-[rgb(1_84_207)]',
  'dark:bg-[rgb(1_97_239)] dark:border-[rgb(1_97_239)]',
  'dark:hover:bg-[rgb(1_84_207)] dark:hover:border-[rgb(1_84_207)]',
].join(' ');

const metadata = {
  title: 'Michael Moreno | Product Marketing Leader, Security, Data & AI',
  ignoreTitleTemplate: true,
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Michael Moreno',
  jobTitle: 'Product Marketing Leader',
  sameAs: [LINKEDIN_URL],
};

// Neutral placeholders until real assets are supplied; the widgets accept
// raw HTML strings for images so no new component is needed.
  const headshot = `
  <img
    src="/images/michael-moreno-headshot.png"
    alt="Michael Moreno, seated in a navy blazer and white shirt, smiling"
    width="946"
    height="1110"
    loading="lazy"
    decoding="async"
    class="mx-auto w-full max-w-md rounded-lg object-cover"
  />
`;

const imagePlaceholder = `
  <div class="flex aspect-[16/10] w-full items-center justify-center bg-gradient-to-br from-slate-800 to-slate-900 text-sm font-medium text-slate-400" aria-label="Image placeholder">
    [Image]
  </div>
`;

const photoAvatar = (src: string, name: string) => `
  <img
    src="${src}"
    alt="${name}"
    width="40"
    height="40"
    loading="lazy"
    decoding="async"
    class="h-10 w-10 rounded-full border border-slate-700 object-cover"
  />
`;
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'About', href: '#about' },
        { text: 'Expertise', href: '#expertise' },
        { text: 'Experience', href: '#experience' },
        { text: 'Skills', href: '#skills' },
        { text: 'Accomplishments', href: '#accomplishments' },
      ]}
      actions={[{ text: 'Message Me', href: '#contact' }]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    title="Michael Moreno"
    actions={[
      {
        variant: 'primary',
        text: 'Download Résumé',
        href: '/resume.pdf',
        icon: 'tabler:download',
        class: BLUE_BUTTON,
      },
      { variant: 'secondary', text: 'Message Me', href: '#contact' },
    ]}
  >
    <Fragment slot="subtitle">
      <span class="block text-xl sm:text-2xl font-semibold text-heading"
        >I translate technology features into business outcomes that drive revenue.</span
  >
  </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    id="stats"
    stats={[
      { amount: '44X', title: 'Google-sourced revenue' },
      { amount: '$50M', title: 'Partner-influenced pipeline' },
      { amount: '$7M+', title: 'First-year Marketplace revenue' },
      { amount: '$3M+', title: 'Closed-won, first gen-AI portfolio' },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-linkedin',
        callToAction: {
          target: '_blank',
          text: 'LinkedIn',
          href: LINKEDIN_URL,
        },
      },
    ]}
    image={headshot}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About</h2>
      <p>
        Most technology companies build faster than their market understands them. The product is ahead of the story,
        and growth stalls at feature-selling. I close that gap: I find where market perception lags what a product can
        actually do, then build the positioning, launch, and partner motion that turns it into pipeline.
      </p>
      <br />
      <p>
        I started in computer science and software engineering, then spent ten years at Intel selling and marketing into
        accounts like Lenovo and IBM, where I learned how technology actually gets bought. Since then I've led product,
        solutions, and partner marketing at Cloudera, Cloudflare, Exabeam, SADA, and Procore, across data, security,
        cloud, and AI.
      </p>
      <br />
      <p>
        I also build with AI myself. I created CampaignAgent, an agentic marketing attribution platform, which keeps me
        fluent in how AI is changing both the products we market and how marketing teams work. I'm based in Austin and
        work in English, Spanish, and Portuguese.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Features3 Widget ************** -->

  <Features3
    id="expertise"
    title="Expertise"
    subtitle="Three things I'm hired to do."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'Complexity into outcomes',
        description:
          'I make complex platforms make sense to technical buyers and executives, and move companies from selling features to selling outcomes.',
        icon: 'tabler:target',
      },
      {
        title: 'Ecosystems into revenue',
        description:
          'I turn partners, marketplaces, and channels into a repeatable revenue engine, with one message carried across every channel.',
        icon: 'tabler:chart-arrows',
      },
      {
        title: 'AI-native GTM',
        description:
          'I build with AI, not just talk about it, so teams adopt AI workflows faster and AI products get positioned credibly.',
        icon: 'tabler:users-group',
      },
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    id="experience"
    title="Experience"
    items={[
      {
        title:
          'Procore <br /> <span class="font-normal">Principal Product Marketing Manager</span> <br /> <span class="text-sm font-normal text-muted">2025 to 2026</span>',
        description: `Led the launch and GTM for Owner-specific features that expand Procore's SOM from $300M to over $450M. <br /> Created nine core sales assets that moved $2M in pipeline and converted $500K in closed-won revenue with a customer in 2H 2025. <br /> Led CFO and CIO forums that produced $2.6M in sourced pipeline and 89% positive executive sentiment.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'SADA <br /> <span class="font-normal">Director of Solutions Marketing</span> <br /> <span class="text-sm font-normal text-muted">2024 to 2025</span>',
        description: `Built and led a team of five product marketers, standing up the solutions marketing function from scratch. <br /> Led positioning for SADA's first generative-AI solution portfolio, contributing $3M+ in closed-won revenue. <br /> Built solution-level messaging frameworks that position AI transformation outcomes, not features.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Exabeam <br /> <span class="font-normal">Senior Product Marketing Manager</span> <br /> <span class="text-sm font-normal text-muted">2021 to 2024</span>',
        description: `Led the 'Built on Google Cloud' campaign, achieving a 44X increase in Google-sourced revenue and the 2023 Google Technology Partner of the Year Award. <br /> Launched Exabeam in the Google Cloud Marketplace, delivering over $7M in revenue in the first year. <br /> Built competitive intelligence and messaging that supported $50M+ in partner-influenced pipeline.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Cloudflare <br /> <span class="font-normal">Senior Partner Marketing Manager, Americas</span> <br /> <span class="text-sm font-normal text-muted">2019 to 2021</span>',
        description: `Built the Americas partner-marketing motion and led platform GTM programs that generated $6.5M in pipeline. <br /> Implemented product-led growth strategies with North and South American resellers, generating over $2M in closed-won net new ARR. <br /> Led the global campaign integrating Cloudflare into OEM partner IBM's go-to-market.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Cloudera <br /> <span class="font-normal">Senior Product Marketing Manager, SaaS Partnerships</span> <br /> <span class="text-sm font-normal text-muted">2015 to 2019</span>',
        description: `Owned the messaging and GTM behind Cloudera's customer-insights motion, a core driver of annual ARR growth. <br /> Built an ISV demo program that produced 7K qualified leads and $9M in partner-sourced revenue. <br /> Named Most Innovative Marketer of the Year.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Intel <br /> <span class="font-normal">Enterprise and Regional Marketing Manager</span> <br /> <span class="text-sm font-normal text-muted">[years]</span>',
        description: `Defined and launched Lenovo's first Hyper-Converged Platform, generating $50M in annual revenue. <br /> Led enterprise and regional marketing for Lenovo, IBM, and Latin America accounts.`,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Features3 Widget: Skills ************** -->

  <Features3
    id="skills"
    title="Skills"
    subtitle="The skills behind the outcomes."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        icon: 'tabler:target-arrow',
        title: 'Positioning and messaging',
        description:
          'Category narratives that land with engineers and executives, from SIEM to gen-AI to capital planning.',
      },
      {
        icon: 'tabler:rocket',
        title: 'Product launches and GTM',
        description:
          'End-to-end launches across Product, Sales, and Marketing, including a Google Cloud Marketplace launch with $7M+ in first-year revenue.',
      },
      {
        icon: 'tabler:affiliate',
        title: 'Partner and ecosystem marketing',
        description: 'Hyperscaler, GSI, ISV, and OEM programs, including a 44X increase in Google-sourced revenue.',
      },
      {
        icon: 'tabler:presentation',
        title: 'Sales enablement',
        description:
          'Battlecards, pitch decks, and training built by someone who spent ten years carrying a quota.',
      },
      {
        icon: 'tabler:chess',
        title: 'Competitive intelligence and analyst relations',
        description: 'Win/loss-informed messaging and analyst work with Gartner and Dresner Advisory.',
      },
      {
        icon: 'tabler:tags',
        title: 'Pricing and packaging',
        description: 'SKU naming, positioning, and feature packaging in partnership with Product and Finance.',
      },
      {
        icon: 'tabler:robot',
        title: 'AI-native building',
        description:
          'Builder of CampaignAgent, an agentic marketing attribution platform, and an AI pricing and packaging tool.',
      },
      {
        icon: 'tabler:broadcast',
        title: 'Integrated campaigns',
        description: 'One message carried across events, social, partner channels, and web.',
      },
      {
        icon: 'tabler:users-group',
        title: 'Team leadership',
        description: 'Built and led a five-person solutions marketing team from scratch at SADA.',
      },
    ]}
  />

  <!-- Projects Widget *************** -->

  <Projects
    id="accomplishments"
    title="Key accomplishments"
    subtitle="Where the story caught up to the product."
    items={[
      {
        title: 'Built on Google Cloud',
        description:
          "Exabeam needed a new route to enterprise security buyers already committed to Google Cloud. I led the 'Built on Google Cloud' campaign and Marketplace launch, aligning positioning, enablement, and co-selling with Google.",
        image: imagePlaceholder,
        tags: ['Partner GTM', 'Marketplace', 'Security'],
        result: '44X Google-sourced revenue. 2023 Google Technology Partner of the Year.',
      },
      {
        title: "SADA's first gen-AI portfolio",
        description:
          'SADA had powerful generative-AI capability but no story enterprise buyers would pay for. I built the solutions marketing team and a messaging framework that sold AI transformation outcomes, not features.',
        image: imagePlaceholder,
        tags: ['AI', 'Launch', 'Team building'],
        result: '$3M+ closed-won revenue.',
      },
      {
        title: 'Procore for Owners',
        description:
          'Procore was built for contractors and needed a story for a new buyer: owners managing capital projects. I led the launch and GTM for Owner-specific features and the narrative behind them.',
        image: imagePlaceholder,
        tags: ['New segment', 'Launch', 'Positioning'],
        result: 'SOM expanded from $300M to over $450M.',
      },
    ]}
  />

  <!-- Testimonials Widget *********** -->

  <Testimonials
    id="testimonials"
    title="What colleagues say"
  subtitle="From managers, partners, and teammates."
  testimonials={[
  {
  testimonial:
  'Mike is a skilled marketer with extensive experience in messaging, positioning, sales enablement, and building successful partnerships. His focus and approach helped to earn a Cloud Partner of the Year award as well as create and market the key value proposition of observability platforms and SIEM technology.',
  name: 'Erin Winchester',
  job: 'Product Marketing Leader, managed Michael at Exabeam',
        image: photoAvatar('/images/testimonials/erin-winchester.jpeg', 'Erin Winchester'),
  },
  {
  testimonial:
  "His help was extremely valuable in helping market Intel SSDs as well as helping with CPU transitions. Michael was always very connected to our Business Unit and truly wore our team's shirt. A fierce team player and well rounded marketing professional.",
  name: 'Rodrigo Mancilla',
  job: 'Product Management Leader, Compute Platforms',
        image: photoAvatar('/images/testimonials/rodrigo-mancilla.png', 'Rodrigo Mancilla'),
  },
  {
  testimonial:
  'I worked with Michael developing Sales Enablement and Demand Gen campaigns for our channel partners. Michael has such a partnership approach, even in tough negotiations. He is very responsive to partner needs.',
  name: 'Lisa Crawford',
  job: 'Channel Partner Account Manager',
        image: photoAvatar('/images/testimonials/lisa-crawford.jpeg', 'Lisa Crawford'),
  },
  ]}
  />

  <!-- Contact Widget **************** -->

  <CallToAction
    id="contact"
    title="Let's talk"
    subtitle="Open to Director and Head of Product Marketing roles in security, data, and AI. The fastest way to reach me is below."
    actions={[
      {
        variant: 'primary',
        text: 'Email me',
        href: 'mailto:mlmoreno@gmail.com',
        icon: 'tabler:mail',
        class: BLUE_BUTTON,
      },
      {
        variant: 'secondary',
        text: 'Connect on LinkedIn',
        href: LINKEDIN_URL,
        target: '_blank',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />
</Layout>
